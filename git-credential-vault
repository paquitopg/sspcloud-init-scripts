#!/usr/bin/env python3
"""
git-credential-vault
====================
Helper d'identifiants Git : trouve le bon token selon la forge appelee,
en le cherchant successivement :
  1. dans les variables d'environnement (si elles sont propagees) ;
  2. sinon directement dans Vault, via VAULT_ADDR / VAULT_TOKEN qui sont,
     eux, toujours presents dans la session SSP Cloud.

Aucune donnee personnelle dans ce fichier : le nom d'utilisateur envoye est
un identifiant technique generique (les forges l'ignorent quand le mot de
passe est un token d'acces personnel).

Installe par setup_git.sh dans ~/.local/bin/. Git l'appelle automatiquement.
"""

import json
import os
import sys
import urllib.request

# Domaine -> (nom d'utilisateur technique, nom de la cle du token)
# 'x-access-token' (GitHub) et 'oauth2' (GitLab) sont des conventions : avec un
# token, la forge ignore ce champ. Aucune donnee personnelle n'y figure.
FORGES = {
    "github.com":      ("x-access-token", "GITHUB_TOKEN"),
    "gitlab.com":      ("oauth2",         "GITLAB_TOKEN"),
}

TIMEOUT = 5
MAX_DEPTH = 4


def vault_request(url):
    token = os.environ.get("VAULT_TOKEN", "")
    req = urllib.request.Request(url, headers={"X-Vault-Token": token})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return json.load(resp)


def vault_find_key(key_name):
    """Cherche `key_name` dans l'arborescence de secrets de l'utilisateur."""
    addr = os.environ.get("VAULT_ADDR", "").rstrip("/")
    token = os.environ.get("VAULT_TOKEN", "")
    mount = os.environ.get("VAULT_MOUNT", "onyxia-kv")
    top = os.environ.get("VAULT_TOP_DIR", "").strip("/")

    if not addr or not token:
        return None

    def walk(path, depth=0):
        if depth > MAX_DEPTH:
            return None
        clean = path.strip("/")
        try:
            data = vault_request(f"{addr}/v1/{mount}/data/{clean}")
            value = (data.get("data") or {}).get("data", {}).get(key_name)
            if value:
                return value
        except Exception:
            pass
        try:
            listing = vault_request(f"{addr}/v1/{mount}/metadata/{clean}?list=true")
            for entry in (listing.get("data") or {}).get("keys", []):
                sub = f"{clean}/{entry}" if clean else entry
                found = walk(sub, depth + 1)
                if found:
                    return found
        except Exception:
            pass
        return None

    return walk(top)


def get_secret(key_name):
    """Variable d'environnement, sinon Vault."""
    value = os.environ.get(key_name, "").strip()
    if value:
        return value
    return (vault_find_key(key_name) or "").strip()


def read_git_request():
    fields = {}
    for line in sys.stdin:
        line = line.strip()
        if not line:
            break
        if "=" in line:
            k, v = line.split("=", 1)
            fields[k] = v
    return fields


def main():
    # Mode utilitaire : `git-credential-vault secret NOM_DE_CLE`
    # Permet aux scripts d'init de lire une valeur dans Vault (nom, email...)
    # sans jamais l'ecrire dans un fichier.
    if len(sys.argv) >= 3 and sys.argv[1] == "secret":
        sys.stdout.write(get_secret(sys.argv[2]))
        return

    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return

    host = read_git_request().get("host", "")
    if host not in FORGES:
        return

    username, key_name = FORGES[host]
    token = get_secret(key_name)

    if token:
        sys.stdout.write(f"username={username}\n")
        sys.stdout.write(f"password={token}\n")
    else:
        sys.stderr.write(
            f"[git-credential-vault] Aucun token trouve pour {host} "
            f"(cle attendue : {key_name}). Verifie le secret dans Vault.\n"
        )


if __name__ == "__main__":
    main()